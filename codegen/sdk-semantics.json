{
  "schema_version": 2,
  "client": { "name": "Mistral" },
  "models": {
    "Message": {
      "raw": "ChatCompletionRequestMessagesItemUnion",
      "union": {
        "root": "ChatCompletionRequest", "path": ["messages", "items"], "payload": "content",
        "targets": ["ChatModerationRequestInputItemUnion", "InstructRequestMessagesItemUnion"]
      }
    },
    "ChatRequest": {
      "raw": "ChatCompletionRequest",
      "constructor": ["model", "messages"],
      "adapters": { "messages": "Message" },
      "exclude": ["stream"]
    },
    "ChatResponse": {
      "raw": "ChatCompletionResponse",
      "borrowed": false,
      "accessors": {
        "text": { "kind": "first_string_variant", "path": ["choices", "first", "message", "content", "optional", "optional"] }
      }
    },
    "ChatStreamChunk": {
      "raw": "CompletionChunk",
      "borrowed": false,
      "accessors": {
        "text": { "kind": "first_string_variant", "path": ["choices", "first", "delta", "content", "optional", "optional"] }
      }
    },
    "OcrPage": {
      "raw": "OCRPageObject",
      "borrowed": true,
      "accessors": {
        "index": { "kind": "copy", "path": ["index"] },
        "markdown": { "kind": "ref", "path": ["markdown"] }
      }
    },
    "OcrRequest": {
      "raw": "OCRRequest",
      "exclude": ["document", "model"],
      "union_factory": { "field": "document", "leading": ["model"], "rename": { "file": "file_id" } }
    },
    "OcrResponse": {
      "raw": "OCRResponse",
      "borrowed": false,
      "accessors": {
        "model": { "kind": "ref", "path": ["model"] },
        "pages": { "kind": "iter", "path": ["pages"], "wrapper": "OcrPage" }
      }
    },
    "ModelListResponse": { "raw": "ModelList", "borrowed": false, "accessors": {} },
    "BaseModel": {
      "raw": "BaseModelCard", "borrowed": false,
      "accessors": { "id": { "kind": "ref", "path": ["id"] } }
    },
    "FineTunedModel": {
      "raw": "FTModelCard", "borrowed": false,
      "accessors": { "id": { "kind": "ref", "path": ["id"] }, "archived": { "kind": "copy", "path": ["archived"] } }
    },
    "ModelResponse": {
      "raw": "RetrieveModelV1ModelsModelIdGetResponse",
      "simple_union": {
        "bidirectional": true,
        "variants": {
          "BaseModelCard": { "name": "Base", "adapter": "BaseModel" },
          "FTModelCard": { "name": "FineTuned", "adapter": "FineTunedModel" }
        }
      }
    },
    "DeleteModelResponse": {
      "raw": "DeleteModelOut", "borrowed": false,
      "accessors": { "id": { "kind": "ref", "path": ["id"] }, "deleted": { "kind": "copy", "path": ["deleted"] } }
    },
    "ArchiveModelResponse": {
      "raw": "ArchiveFTModelOut", "borrowed": false,
      "accessors": { "id": { "kind": "ref", "path": ["id"] }, "archived": { "kind": "copy", "path": ["archived"] } }
    },
    "UnarchiveModelResponse": {
      "raw": "UnarchiveFTModelOut", "borrowed": false,
      "accessors": { "id": { "kind": "ref", "path": ["id"] }, "archived": { "kind": "copy", "path": ["archived"] } }
    },
    "UpdateModelRequest": { "raw": "UpdateFTModelIn", "constructor": [] },
    "CompletionFineTunedModel": {
      "raw": "CompletionFTModelOut", "borrowed": false,
      "accessors": { "id": { "kind": "ref", "path": ["id"] }, "archived": { "kind": "copy", "path": ["archived"] } }
    },
    "ClassifierFineTunedModel": {
      "raw": "ClassifierFTModelOut", "borrowed": false,
      "accessors": { "id": { "kind": "ref", "path": ["id"] }, "archived": { "kind": "copy", "path": ["archived"] } }
    },
    "UpdateModelResponse": {
      "raw": "JobsApiRoutesFineTuningUpdateFineTunedModelResponse",
      "simple_union": {
        "bidirectional": true,
        "variants": {
          "CompletionFTModelOut": { "name": "Completion", "adapter": "CompletionFineTunedModel" },
          "ClassifierFTModelOut": { "name": "Classifier", "adapter": "ClassifierFineTunedModel" }
        }
      }
    },
    "EmbeddingInput": {
      "raw": "EmbeddingRequestInput",
      "simple_union": { "variants": { "String": "Text", "EmbeddingRequestInputStringArray": "Batch" } }
    },
    "EmbeddingParams": { "raw": "EmbeddingRequest", "constructor": ["model", "input"], "adapters": { "input": "EmbeddingInput" } },
    "Embedding": {
      "raw": "EmbeddingResponseData", "borrowed": true,
      "accessors": {
        "index": { "kind": "optional_copy", "path": ["index"] },
        "values": { "kind": "optional_ref", "path": ["embedding"] }
      }
    },
    "EmbeddingResult": {
      "raw": "EmbeddingResponse", "borrowed": false,
      "accessors": {
        "id": { "kind": "ref", "path": ["id"] },
        "model": { "kind": "ref", "path": ["model"] },
        "embeddings": { "kind": "iter", "path": ["data"], "wrapper": "Embedding" }
      }
    },
    "StopSequences": {
      "raw": "FIMCompletionRequestStop",
      "simple_union": { "variants": { "String": "One", "FIMCompletionRequestStopStringArray": "Many" } }
    },
    "FimRequest": { "raw": "FIMCompletionRequest", "constructor": ["model", "prompt"], "exclude": ["stream"], "adapters": { "stop": "StopSequences" } },
    "FimResponse": {
      "raw": "FIMCompletionResponse", "borrowed": false,
      "accessors": { "text": { "kind": "first_string_variant", "path": ["choices", "first", "message", "content", "optional", "optional"] } }
    },
    "FimStreamChunk": {
      "raw": "CompletionChunk", "borrowed": false,
      "accessors": { "text": { "kind": "first_string_variant", "path": ["choices", "first", "delta", "content", "optional", "optional"] } }
    },
    "ClassificationInput": {
      "raw": "ClassificationRequestInput",
      "simple_union": { "variants": { "String": "Text", "ClassificationRequestInputStringArray": "Batch" } }
    },
    "ClassificationParams": { "raw": "ClassificationRequest", "constructor": ["model", "input"], "adapters": { "input": "ClassificationInput" } },
    "ClassifierConversation": {
      "raw": "InstructRequest", "constructor": ["messages"], "adapters": { "messages": "Message" }
    },
    "ChatClassificationInput": {
      "raw": "ChatClassificationRequestInputs",
      "simple_union": {
        "variants": {
          "InstructRequest": { "name": "Conversation", "adapter": "ClassifierConversation" },
          "InstructRequestArray": { "name": "Batch", "adapter": "ClassifierConversation" }
        }
      }
    },
    "ChatModerationInput": {
      "raw": "ChatModerationRequestInput",
      "simple_union": {
        "variants": {
          "ChatModerationRequestInputArray": { "name": "Conversation", "adapter": "Message" },
          "ChatModerationRequestInputArrayInline": { "name": "Batch", "adapter": "Message" }
        }
      }
    },
    "ChatClassificationParams": {
      "raw": "ChatClassificationRequest", "constructor": ["model", "input"],
      "adapters": { "input": "ChatClassificationInput" }
    },
    "ChatModerationParams": {
      "raw": "ChatModerationRequest", "constructor": ["model", "input"],
      "adapters": { "input": "ChatModerationInput" }
    },
    "ClassificationResult": { "raw": "ClassificationResponseResultsItem", "borrowed": true, "accessors": {} },
    "ClassificationResultSet": {
      "raw": "ClassificationResponse", "borrowed": false,
      "accessors": {
        "id": { "kind": "ref", "path": ["id"] },
        "model": { "kind": "ref", "path": ["model"] },
        "results": { "kind": "iter", "path": ["results"], "wrapper": "ClassificationResult" }
      }
    },
    "ModerationResult": { "raw": "ModerationObject", "borrowed": true, "accessors": {} },
    "ModerationResultSet": {
      "raw": "ModerationResponse", "borrowed": false,
      "accessors": {
        "id": { "kind": "ref", "path": ["id"] },
        "model": { "kind": "ref", "path": ["model"] },
        "results": { "kind": "iter", "path": ["results"], "wrapper": "ModerationResult" }
      }
    }
  },
  "resources": {
    "chat": {
      "name": "Chat",
      "operations": {
        "complete": { "operation_id": "chat_completion_v1_chat_completions_post", "request": "ChatRequest", "response": "ChatResponse", "request_overrides": { "stream": false } },
        "stream": {
          "operation_id": "chat_completion_v1_chat_completions_post",
          "raw_method": "chat_completion_v1_chat_completions_post_stream",
          "request": "ChatRequest",
          "request_overrides": { "stream": true },
          "stream": { "item": "CompletionChunk", "wrapper": "ChatStreamChunk", "type": "ChatStream" }
        }
      }
    },
    "ocr": {
      "name": "Ocr",
      "operations": {
        "process": { "operation_id": "ocr_v1_ocr_post", "request": "OcrRequest", "response": "OcrResponse" }
      }
    },
    "models": {
      "name": "Models",
      "operations": {
        "list": { "operation_id": "list_models_v1_models_get", "response": "ModelListResponse" },
        "retrieve": { "operation_id": "retrieve_model_v1_models__model_id__get", "raw_method": "retrieve_model_v1_models_model_id_get", "response": "ModelResponse" },
        "delete": { "operation_id": "delete_model_v1_models__model_id__delete", "raw_method": "delete_model_v1_models_model_id_delete", "response": "DeleteModelResponse" },
        "update": { "operation_id": "jobs_api_routes_fine_tuning_update_fine_tuned_model", "request": "UpdateModelRequest", "response": "UpdateModelResponse" },
        "archive": { "operation_id": "jobs_api_routes_fine_tuning_archive_fine_tuned_model", "response": "ArchiveModelResponse" },
        "unarchive": { "operation_id": "jobs_api_routes_fine_tuning_unarchive_fine_tuned_model", "response": "UnarchiveModelResponse" }
      }
    },
    "embeddings": {
      "name": "Embeddings",
      "operations": { "create": { "operation_id": "embeddings_v1_embeddings_post", "request": "EmbeddingParams", "response": "EmbeddingResult" } }
    },
    "fim": {
      "name": "Fim",
      "operations": {
        "complete": { "operation_id": "fim_completion_v1_fim_completions_post", "request": "FimRequest", "response": "FimResponse", "request_overrides": { "stream": false } },
        "stream": { "operation_id": "fim_completion_v1_fim_completions_post", "raw_method": "fim_completion_v1_fim_completions_post_stream", "request": "FimRequest", "request_overrides": { "stream": true }, "stream": { "item": "CompletionChunk", "wrapper": "FimStreamChunk", "type": "FimStream" } }
      }
    },
    "classifiers": {
      "name": "Classifiers",
      "operations": {
        "moderate": { "operation_id": "moderations_v1_moderations_post", "request": "ClassificationParams", "response": "ModerationResultSet" },
        "moderate_chat": { "operation_id": "chat_moderations_v1_chat_moderations_post", "request": "ChatModerationParams", "response": "ModerationResultSet" },
        "classify": { "operation_id": "classifications_v1_classifications_post", "request": "ClassificationParams", "response": "ClassificationResultSet" },
        "classify_chat": { "operation_id": "chat_classifications_v1_chat_classifications_post", "request": "ChatClassificationParams", "response": "ClassificationResultSet" }
      }
    }
  }
}
