{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "openapi-to-rust facade RawIr sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "structs", "enums", "aliases", "operations", "symbol_modules"],
  "properties": {
    "schema_version": {"const": 1},
    "structs": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "type"],
          "properties": {
            "name": {"type": "string"},
            "type": {"type": "string"}
          }
        }
      }
    },
    "enums": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "payload"],
          "properties": {
            "name": {"type": "string"},
            "payload": {"type": ["string", "null"]}
          }
        }
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "operations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "parameters", "return_type", "success_type"],
        "properties": {
          "name": {"type": "string"},
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": {"type": "string"},
                "type": {"type": "string"}
              }
            }
          },
          "return_type": {"type": "string"},
          "success_type": {"type": "string"}
        }
      }
    },
    "symbol_modules": {
      "type": "object",
      "additionalProperties": {"enum": ["types", "client"]}
    }
  }
}
