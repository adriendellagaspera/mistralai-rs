+    // Keep a declared boolean stream parameter aligned with the planned
+    // response representation until the generic request discriminator lands.
+    fn generate_stream_parameter(
+        &self,
+        op: &OperationInfo,
+        analysis: &SchemaAnalysis,
+        call_shape: &ClientCallShapePlan,
+    ) -> TokenStream {
+        use crate::analysis::{RequestBodyContent, SchemaType};
+        if !op.request_body_required {
+            return TokenStream::new();
+        }
+        let name = match op.request_body.as_ref() {
+            Some(RequestBodyContent::Json { schema_name, .. })
+            | Some(RequestBodyContent::Multipart { schema_name, .. }) => schema_name,
+            _ => return TokenStream::new(),
+        };
+        let Some((resolved_name, schema)) = self.resolve_reference_schema(name, analysis) else {
+            return TokenStream::new();
+        };
+        let SchemaType::Object {
+            properties,
+            required,
+            ..
+        } = &schema.schema_type
+        else {
+            return TokenStream::new();
+        };
+        let Some(property) = properties.get("stream") else {
+            return TokenStream::new();
+        };
+        if !matches!(&property.schema_type, SchemaType::Primitive { rust_type, .. } if rust_type == "bool")
+        {
+            return TokenStream::new();
+        }
+        let value = matches!(
+            &call_shape.representation,
+            ClientResponseRepresentation::EventStream { .. }
+        );
+        let value = if self.property_is_tri_state(
+            resolved_name,
+            "stream",
+            property,
+            required.contains("stream"),
+        ) {
+            quote! { Some(Some(#value)) }
+        } else if !required.contains("stream")
+            || self.property_is_nullable(resolved_name, "stream", property)
+        {
+            quote! { Some(#value) }
+        } else {
+            quote! { #value }
+        };
+        quote! { let mut request = request; request.stream = #value; }
+    }
+
